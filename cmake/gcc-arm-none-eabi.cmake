set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
# Explicit cache setting > terminal environment > setup-generated local config > PATH.
# No dependency on STM32CubeIDE or Python installation paths.
set(_local_environment "${CMAKE_CURRENT_LIST_DIR}/../.tools/environment.json")
if(EXISTS "${_local_environment}")
    file(READ "${_local_environment}" _tools_json)
    # Windows PowerShell 5.1 writes UTF-8 with BOM; strip it before JSON parsing.
    string(ASCII 239 187 191 _utf8_bom)
    string(REPLACE "${_utf8_bom}" "" _tools_json "${_tools_json}")
    string(JSON _configured_gcc_bin GET "${_tools_json}" ArmGccBin)
    if(NOT CMAKE_MAKE_PROGRAM)
        string(JSON CMAKE_MAKE_PROGRAM GET "${_tools_json}" NinjaExe)
        file(TO_CMAKE_PATH "${CMAKE_MAKE_PROGRAM}" CMAKE_MAKE_PROGRAM)
        set(CMAKE_MAKE_PROGRAM "${CMAKE_MAKE_PROGRAM}" CACHE FILEPATH "Ninja executable")
    endif()
endif()
if(ARM_GCC_BIN)
    set(_gcc_hint "${ARM_GCC_BIN}")
elseif(DEFINED ENV{ARM_GCC_PATH} AND NOT "$ENV{ARM_GCC_PATH}" STREQUAL "")
    set(_gcc_hint "$ENV{ARM_GCC_PATH}")
elseif(_configured_gcc_bin)
    set(_gcc_hint "${_configured_gcc_bin}")
endif()
if(_gcc_hint)
    find_program(_arm_gcc arm-none-eabi-gcc HINTS "${_gcc_hint}" NO_DEFAULT_PATH NO_CACHE REQUIRED)
else()
    find_program(_arm_gcc arm-none-eabi-gcc NO_CACHE REQUIRED)
endif()
get_filename_component(_arm_bin "${_arm_gcc}" DIRECTORY)
if(_arm_bin MATCHES "[Ss][Tt][Mm]32CubeIDE|gnu-tools-for-stm32")
    message(FATAL_ERROR "Select standalone Arm GNU Toolchain. Run scripts/setup-env.ps1 first.")
endif()
set(CMAKE_C_COMPILER "${_arm_gcc}")
set(CMAKE_ASM_COMPILER "${_arm_gcc}")
find_program(CMAKE_OBJCOPY arm-none-eabi-objcopy HINTS "${_arm_bin}" NO_DEFAULT_PATH REQUIRED)
find_program(CMAKE_SIZE arm-none-eabi-size HINTS "${_arm_bin}" NO_DEFAULT_PATH REQUIRED)
message(STATUS "Standalone Arm GNU Toolchain: ${_arm_bin}")
set(CPU_FLAGS "-mcpu=cortex-m33 -mthumb -mfpu=fpv5-sp-d16 -mfloat-abi=hard")
set(CMAKE_C_FLAGS_INIT "${CPU_FLAGS} -ffunction-sections -fdata-sections -fno-common")
set(CMAKE_ASM_FLAGS_INIT "${CPU_FLAGS} -x assembler-with-cpp")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${CPU_FLAGS}")
